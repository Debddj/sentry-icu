{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ui": {
      "root": "ui",
      "framework": "vite"
    },
    "api": {
      "root": "api",
      "entrypoint": "index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "ui" }
    }
  ]
}
